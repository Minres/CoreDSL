{
    "name": "coredsl-vscode",
    "displayName": "CoreDSL",
    "description": "A CoreDSL plugin for VS Code",
    "version": "2.0.21",
    "publisher": "MINRES",
    "icon": "images/Minres_logo_square.png",
    "license": "EPL-1.0",
    "homepage": "https://github.com/Minres/CoreDSL/blob/master/vscode-extension-self-contained/#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/Minres/CoreDSL.git"
    },
    "bugs": {
        "url": "https://github.com/Minres/CoreDSL/issues"
    },
    "engines": {
        "vscode": "^1.116.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./out/extension",
    "contributes": {
        "languages": [
            {
                "id": "coredsl",
                "aliases": [
                    "CoreDSL", "coredsl"
                ],
                "extensions": [
                    ".core_desc"
                ],
                "configuration": "./coredsl.configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "coredsl",
                "scopeName": "text.coredsl",
                "path": "./syntaxes/coredsl.tmLanguage.json"
            }
        ]
    },
    "devDependencies": {
        "@types/node": "^20.19.39",
        "@types/vscode": "^1.116.0",
        "@vscode/test-electron": "^2.5.2",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./src",
        "watch": "tsc -w -p ./src"
    }
}
